{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -f /opt/everos-bridge/plugin/everos/hook.py ] && python3 /opt/everos-bridge/plugin/everos/hook.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -f /opt/everos-bridge/plugin/everos/hook.py ] && python3 /opt/everos-bridge/plugin/everos/hook.py || true",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -f /opt/everos-bridge/plugin/everos/hook.py ] && python3 /opt/everos-bridge/plugin/everos/hook.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -f /opt/everos-bridge/plugin/everos/hook.py ] && python3 /opt/everos-bridge/plugin/everos/hook.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -f /opt/everos-bridge/plugin/everos/hook.py ] && python3 /opt/everos-bridge/plugin/everos/hook.py || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
