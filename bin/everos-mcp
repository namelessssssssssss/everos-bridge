#!/usr/bin/env python3
"""Bin entry: stdio MCP client for hosts without native MCP registration."""
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "plugin" / "everos"))
sys.path.insert(0, str(ROOT / "plugin" / "doubao"))
import mcp_call

if __name__ == "__main__":
    sys.exit(mcp_call.main(sys.argv[1:]))
